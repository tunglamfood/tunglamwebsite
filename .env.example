# Copy to .env (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values — .env* is gitignored (this example file is the exception).

# --- Supabase (project region: ap-southeast-1 / Singapore) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=            # public, read-only via RLS
SUPABASE_SERVICE_ROLE_KEY=    # server only: writes enquiries, used by the seed script
SUPABASE_ACCESS_TOKEN=        # management API (migrations); not needed on Vercel

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://tunglamfood.my
REVALIDATE_SECRET=            # random string; protects POST /api/revalidate
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=   # optional: Google Search Console meta token
NEXT_PUBLIC_BING_SITE_VERIFICATION=     # optional: Bing Webmaster meta token

# --- Admin panel (/admin) ---
# Staff sign in with their own ERP staff login (needs "Website content"), checked
# against the ERP database below — there is no shared admin password any more.
ADMIN_SESSION_SECRET=         # random 64-hex string; rotating it signs everyone out

# --- Dealer portal (/portal) — reads/writes the ERP database (tunglam.vercel.app) ---
ERP_SUPABASE_URL=             # https://<erp-project-ref>.supabase.co
ERP_SUPABASE_SECRET_KEY=      # the ERP's "tunglamfood_portal" secret key (server only)
PORTAL_SESSION_SECRET=        # random 64-hex string
PORTAL_DEMO_OTP=              # demo only: e.g. 123123 lets every registered phone sign in. LEAVE EMPTY IN PRODUCTION.
# Real sign-in codes by SMS (OneWay SMS, Malaysia). Used when PORTAL_DEMO_OTP is empty.
ONEWAYSMS_API_USERNAME=
ONEWAYSMS_API_PASSWORD=
ONEWAYSMS_SENDER_ID=          # optional, default INFO
ONEWAYSMS_MT_URL=             # optional, default https://gateway.onewaysms.com.my/api.aspx

# --- Auto posts (daily AI recipes + guides, src/lib/auto-content) — also set these on Vercel ---
OPENAI_API_KEY=               # writes and reviews the posts
OPENAI_MODEL=                 # optional, default gpt-5.4 (writer)
OPENAI_REVIEW_MODEL=          # optional, default gpt-5.4-mini (editor, duplicate judge)
KIE_API_KEY=                  # photos (also used by scripts/kie-image.mjs)
CRON_SECRET=                  # random string; Vercel Cron sends it to /api/auto-content/cron

# --- Other keys kept for future features (not used by the site yet) ---
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_VISION_API_KEY=
SERPAPI_API_KEY=
