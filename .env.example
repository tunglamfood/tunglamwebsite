# Copy to .env (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values — .env* is gitignored (this example file is the exception).

# --- Supabase (project region: ap-southeast-1 / Singapore) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=            # public, read-only via RLS
SUPABASE_SERVICE_ROLE_KEY=    # server only: writes enquiries, used by the seed script
SUPABASE_ACCESS_TOKEN=        # management API (migrations); not needed on Vercel

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://tunglamfood.my
REVALIDATE_SECRET=            # random string; protects POST /api/revalidate
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=   # optional: Google Search Console meta token
NEXT_PUBLIC_BING_SITE_VERIFICATION=     # optional: Bing Webmaster meta token

# --- Image generation (scripts/kie-image.mjs; not needed on Vercel) ---
KIE_API_KEY=

# --- Other keys kept for future features (not used by the site yet) ---
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_API_KEY=
GOOGLE_VISION_API_KEY=
SERPAPI_API_KEY=
OPENAI_API_KEY=
